__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Tests y coverage
.pytest_cache/
htmlcov/
.coverage
*.cover

# Git
.git/
.gitignore
.github/

# IDEs
.vscode/
.idea/
*.swp

# Documentación
*.md
README.md

# Sistema operativo
.DS_Store
Thumbs.db